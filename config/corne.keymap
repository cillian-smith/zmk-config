#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// three letter layer names
#define BSE 0
#define MED 1
#define NAV 2
#define MSE 3
#define SYM 4
#define NUM 5
#define FUN 6

//define short homerow mod keys 
#define HRA LGUI A
#define HRR LALT R
#define HRS LCTRL S
#define HRT LSHIFT T

#define HRN LSHIFT N
#define HRE LCTRL E
#define HRI LALT I
#define HRO LGUI O

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ----------------------------------------------------------------------
// | |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  '  | |
// | |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  | |
// | |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | |
//               | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &none &kp Q   &kp W   &kp F   &kp P   &kp B   &kp J &kp L   &kp U   &kp Y   &kp SQT &none
   &none &mt HRA &mt HRR &mt HRS &mt HRT &kp G   &kp M &mt HRN &mt HRE &mt HRI &mt HRO &none
   &none &kp Z   &kp X   &kp C   &kp D   &kp V   &kp K &kp H   &kp COMMA &kp DOT &kp FSLH &none
         &lt MED ESC &lt SPACE NAV &lt TAB MSE   &lt RET SYM &lt BSPC NUM &lt FUN DEL
                        >;
                };
                media {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &none    &none    &none     &none     &none        &none   &kp K_REDO &kp K_PASTE &kp K_COPY &kp K_CUT &kp K_UNDO &none
   &none &kp LGUI &kp LALT &kp LCTRL &kp LGUI &none   &kp CAPS &kp LEFT &kp DOWN &kp UP &kp RIGHT &none
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                navigation  {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
                mouse {
// ----------------------------------------------------------------------
// | |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  '  | |
// | |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  | |
// | |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | |
//               | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &none &kp Q   &kp W   &kp F   &kp P   &kp B   &kp J &kp L   &kp U   &kp Y   &kp SQT &none
   &none &mt HRA &mt HRR &mt HRS &mt HRT &kp G   &kp M &mt HRN &mt HRE &mt HRI &mt HRO &none
   &none &kp Z   &kp X   &kp C   &kp D   &kp V   &kp K &kp H   &kp COMMA &kp DOT &kp FSLH &none
         &lt MED ESC &lt SPACE NAV &lt TAB MSE   &lt RET SYM &lt BSPC NUM &lt FUN DEL
                        >;
                };
                symbols {
// ----------------------------------------------------------------------
// | |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  '  | |
// | |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  | |
// | |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | |
//               | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &none &kp Q   &kp W   &kp F   &kp P   &kp B   &kp J &kp L   &kp U   &kp Y   &kp SQT &none
   &none &mt HRA &mt HRR &mt HRS &mt HRT &kp G   &kp M &mt HRN &mt HRE &mt HRI &mt HRO &none
   &none &kp Z   &kp X   &kp C   &kp D   &kp V   &kp K &kp H   &kp COMMA &kp DOT &kp FSLH &none
         &lt MED ESC &lt SPACE NAV &lt TAB MSE   &lt RET SYM &lt BSPC NUM &lt FUN DEL
                        >;
                };
               numbers {
// ----------------------------------------------------------------------
// | |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  '  | |
// | |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  | |
// | |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | |
//               | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &none &kp Q   &kp W   &kp F   &kp P   &kp B   &kp J &kp L   &kp U   &kp Y   &kp SQT &none
   &none &mt HRA &mt HRR &mt HRS &mt HRT &kp G   &kp M &mt HRN &mt HRE &mt HRI &mt HRO &none
   &none &kp Z   &kp X   &kp C   &kp D   &kp V   &kp K &kp H   &kp COMMA &kp DOT &kp FSLH &none
         &lt MED ESC &lt SPACE NAV &lt TAB MSE   &lt RET SYM &lt BSPC NUM &lt FUN DEL
                        >;
                };
               functions {
// ----------------------------------------------------------------------
// | |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  '  | |
// | |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  | |
// | |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | |
//               | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &none &kp Q   &kp W   &kp F   &kp P   &kp B   &kp J &kp L   &kp U   &kp Y   &kp SQT &none
   &none &mt HRA &mt HRR &mt HRS &mt HRT &kp G   &kp M &mt HRN &mt HRE &mt HRI &mt HRO &none
   &none &kp Z   &kp X   &kp C   &kp D   &kp V   &kp K &kp H   &kp COMMA &kp DOT &kp FSLH &none
         &lt MED ESC &lt SPACE NAV &lt TAB MSE   &lt RET SYM &lt BSPC NUM &lt FUN DEL
                        >;
                };
        };
};
